# Non-prod values. Replace every <...> with your own value.
# None of these are secrets. Never put a client secret or key in this file.

subscription_id = "<non-prod-ai-subscription-id>"
tenant_id       = "<tenant-id>"
location        = "westus3"

resource_group_name = "<rg-name>"   # module creates it; it must not already exist
name_prefix         = "<prefix>"    # 10 characters or fewer, lowercase letters and digits

tags = {
  # Your required tags
  # Environment = "nonprod"
}

existing_vnet_resource_id   = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>"
dns_zones_resource_group_id = "/subscriptions/<sub>/resourceGroups/<dns-rg>"

# true if your Azure Policy adds private endpoint DNS records, false if the module should
pe_dns_registration_by_policy = true

project_name         = "<project-name>"
project_display_name = "<display name>"
project_description  = "<description>"

apim_publisher_email = "<shared-mailbox@your-domain.com>"
apim_publisher_name  = "<owner display name>"
# apim_sku_root and apim_sku_capacity default to Developer and 1 (non-prod)
